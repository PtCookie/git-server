#!/bin/sh
# vim: sw=4:ts=4:et

set -eu

. "$(dirname "$0")/common.sh"

usage() {
	echo "Show or set the default branch (HEAD) of a repository."
	printf '\n'
	echo "Usage : git head NAME [BRANCH]"
	echo "        git-head NAME [BRANCH]"
	printf '\n'
	echo "Without BRANCH the current default branch is printed."
	echo "BRANCH has to exist already, otherwise clones would look empty."
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
esac

if [ $# -lt 1 ]; then
	die_usage "no repository name given."
fi

if [ $# -gt 2 ]; then
	die_usage "too many arguments."
fi

REPOSITORY_NAME="$(repo_name "$1")" || exit 1
REPOSITORY_DIR="$(repo_dir "${REPOSITORY_NAME}")"

require_repository "${REPOSITORY_NAME}" || exit 1

if [ $# -eq 1 ]; then
	git -C "${REPOSITORY_DIR}" symbolic-ref --short HEAD
	exit 0
fi

BRANCH="$2"

if ! git -C "${REPOSITORY_DIR}" show-ref --verify --quiet "refs/heads/${BRANCH}"; then
	warn "branch '${BRANCH}' does not exist in ${REPOSITORY_NAME}."
	echo "Existing branches:" >&2
	git -C "${REPOSITORY_DIR}" for-each-ref --format='  %(refname:short)' refs/heads >&2
	exit 1
fi

git -C "${REPOSITORY_DIR}" symbolic-ref HEAD "refs/heads/${BRANCH}"

echo "Default branch of ${REPOSITORY_NAME} is now ${BRANCH}."
