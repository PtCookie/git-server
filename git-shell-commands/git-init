#!/bin/sh
# vim: sw=4:ts=4:et

set -eu

. "$(dirname "$0")/common.sh"

usage() {
	echo "Initialize a bare git repository."
	printf '\n'
	echo "Usage : git init NAME OWNER [DESC] [SECTION]"
	echo "        git-init NAME OWNER [DESC] [SECTION]"
	printf '\n'
	echo "A trailing '.git' in NAME is ignored."
	echo "DESC and SECTION are stored as cgit metadata."
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
esac

if [ $# -lt 1 ]; then
	die_usage "no name given."
fi

if [ $# -lt 2 ]; then
	die_usage "no owner given."
fi

if [ $# -gt 4 ]; then
	die_usage "too many arguments."
fi

REPOSITORY_NAME="$(repo_name "$1")" || exit 1
REPOSITORY_OWNER="$2"
REPOSITORY_DESC="${3:-}"
REPOSITORY_SECTION="${4:-}"

REPOSITORY_DIR="$(repo_dir "${REPOSITORY_NAME}")"

require_no_repository "${REPOSITORY_NAME}" || exit 1

# Do not leave a half-created repository behind if any step below fails.
INCOMPLETE=1
trap '[ -z "${INCOMPLETE}" ] || rm -rf "${REPOSITORY_DIR}"' EXIT

git init --bare "${REPOSITORY_DIR}"

install_hooks "${REPOSITORY_DIR}"

set_metadata "${REPOSITORY_DIR}" \
	"${REPOSITORY_NAME}" \
	"${REPOSITORY_OWNER}" \
	"${REPOSITORY_DESC}" \
	"${REPOSITORY_SECTION}"

link_repo "${REPOSITORY_NAME}"

INCOMPLETE=

echo "Initialized repository ${REPOSITORY_NAME}."
