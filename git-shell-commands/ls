#!/bin/sh
# vim: sw=4:ts=4:et

set -eu

. "$(dirname "$0")/common.sh"

usage() {
	echo "List repositories."
	printf '\n'
	echo "Usage : ls"
	printf '\n'
	echo "Names are printed without the '.git' suffix,"
	echo "the same form the other commands expect."
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
esac

REPOSITORIES="$(list_repositories)"

if [ -z "${REPOSITORIES}" ]; then
	echo "No repositories."
	exit 0
fi

printf '%s\n' "${REPOSITORIES}"
