#!/bin/sh
# vim: sw=4:ts=4:et

set -eu

. "$(dirname "$0")/common.sh"

COMMAND_DIR="$(dirname "$0")"

if [ $# -eq 0 ]; then
	GIT_VERSION="$(git --version)"

	cat <<EOF
Git Shell (${GIT_VERSION})
Run 'help' for help, or 'exit' to leave.

Repository commands, also usable as 'git-init', 'git-config', ...:
-------------------------------------------------------------
EOF

	cd "${COMMAND_DIR}" || exit 1

	for CMD in git-*; do
		[ -f "$CMD" ] && [ -x "$CMD" ] || continue

		echo "git ${CMD#git-}"
	done

	cat <<EOF

Other commands:
-------------------------------------------------------------
EOF

	for CMD in *; do
		[ -f "$CMD" ] && [ -x "$CMD" ] || continue

		case "$CMD" in
		git | git-*) ;;
		*) echo "$CMD" ;;
		esac
	done

	printf '\n'
	echo "Run 'help COMMAND' to see the usage of a command."
	printf '\n'

	exit 0
fi

# Accept 'help git init' as well as 'help git-init'.
if [ "$1" = "git" ] && [ $# -ge 2 ]; then
	COMMAND="git-$2"
else
	COMMAND="$1"
fi

case "$COMMAND" in
*[!A-Za-z0-9-]*)
	die "not an available command: $*"
	;;
esac

TARGET="${COMMAND_DIR}/${COMMAND}"

if [ ! -f "$TARGET" ] || [ ! -x "$TARGET" ]; then
	warn "not an available command: $*"
	echo "Run 'help' to see available commands." >&2
	exit 1
fi

# Each command documents itself, so there is nothing to keep in sync here.
"$TARGET" --help

printf '\n'
